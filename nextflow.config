/*
 * symbiomics -- eukaryote genome annotation + mRNA-seq pipeline
 * https://github.com/Ufungi/symbiomics
 */

params {
    // ------------------------------------------------------------ input/output
    input                       = null      // RNA-seq samplesheet (.tsv/.csv)
    genomes                     = null      // multi-genome batch table
    mapping_genomes              = null      // -entry symbiont_mapping: tsv of 2+ candidate genomes
    mapping_ambiguous_margin     = 5.0       // percentage points separating best/runner-up genome to call a sample unambiguous
    reference_proteomes         = null
    outdir                      = './results'
    raw_dir                     = null      // base for relative fastq paths
    // 'copy' is the safe default. 'link' (hardlink) avoids duplicating large
    // BAM sets but only works when NXF_WORK and --outdir are on the SAME
    // filesystem -- the launcher puts work on /data/db by default, so set
    // NXF_WORK explicitly before asking for link. See docs/usage.md.
    publish_mode                = 'copy'    // copy | link | symlink | rellink
    steps                       = 'all'
    skip_steps                  = ''
    sample                      = null      // run a single sample_id
    tracedir                    = "${params.outdir}/00_pipeline_info"

    // test / subsampling
    test_mode                   = false
    test_reads                  = 100000
    test_sampler                = 'head'    // head | sample
    test_seed                   = 42
    test_contigs                = 0

    // ------------------------------------------------------------------ genome
    genome                      = null
    fasta                       = null      // alias for genome
    genome_id                   = null      // auto <- fasta basename
    species                     = null      // auto <- genome_id
    species_taxid               = null
    taxon                       = 'auto'    // auto|fungi|plant|animal|other
    clade                       = null      // finer hint, e.g. gymnosperm; gates clade-limited tools
    genome_size_class           = 'auto'    // auto|tiny|small|medium|large|huge
    size_threshold_tiny         = 10000000
    size_threshold_small        = 500000000
    size_threshold_medium       = 2000000000
    size_threshold_large        = 5000000000
    min_contig_len              = 0
    reference_gff               = null
    reference_gff_repair        = true
    locus_tag                   = null
    locus_tag_step              = 10

    // ----------------------------------------------------------------- repeats
    masker                      = 'auto'
    premasked                   = false
    repeat_lib                  = null
    repeat_lib_extra            = null
    repeat_species              = null
    rm_ltrstruct                = 'auto'
    rm_sample_size              = 500000000
    rm_sample_window            = 5000000
    rm_sample_min_contig        = 1000000
    rm_salvage_rounds           = true
    repeatmasker_chunk_mb       = 100
    mask_max_frac               = 0.92
    mask_min_frac               = 0.02
    soft_mask                   = true

    // --------------------------------------------------------------- mRNA-seq
    aligner                     = 'auto'    // auto|hisat2|star
    star_max_genome             = 2000000000
    hisat2_index                = null
    hisat2_index_verify         = true
    hisat2_large_index          = 'auto'
    hisat2_mm                   = 'auto'
    hisat2_extra                = ''
    trimmer                     = 'fastp'   // fastp|trimgalore|none
    min_read_len                = 36
    strandedness                = 'auto'
    strandedness_method         = 'junction'
    strandedness_min_reads      = 20000
    strandedness_subsample      = 400000
    strandedness_threshold      = 0.85
    strict_strandedness         = false
    allow_mixed_strandedness    = false
    bam_index                   = 'auto'    // auto|csi|bai|both
    sort_mem                    = '4G'
    save_bam                    = true
    stringtie_min_tpm           = 0.5
    stringtie_extra             = ''
    run_stringtie               = true

    // ---------------------------------------------------------- quantification
    counter                     = 'featurecounts'   // featurecounts|htseq|both|none
    count_feature               = 'exon'            // NEVER 'gene'
    count_attribute             = 'gene_id'
    count_multimappers          = false
    quant_gff                   = null              // override the GFF used for counting
    quant_engine                = 'hisat2'          // hisat2|salmon
    transcript_fasta             = null              // CSV of 1 (single haplotype) or 2 (diploid EM) CDS FASTAs
    salmon_decoy                = 'auto'            // auto|true|false -- see decide_strategy.py
    genome_hb                   = null              // second-haplotype genome, enables haplotype_pairing (F5+)
    haplotype_pairs              = null              // output of -entry pairing's SYRI_TO_ALLELE_TABLE, for the diploid EM split
    gff3_ha                     = null              // HA gene models -- gene-overlap VCF restriction + allele pairing
    gff3_hb                     = null              // HB gene models -- allele pairing
    minimap_preset               = 'asm10'          // asm5 (<1% divergence) | asm10 (~a few %) | asm20 (up to ~10%)
    ase_vcf_source                = 'assembly'      // assembly (route 1, syri) | resequencing (route 2) | <path to a VCF>
    resequencing_variation_file  = null
    resequencing_accession       = null
    run_ase                      = false
    ase_sample_name               = 'HA_HB'  // must match the phased VCF's sample column
    ase_phased_vcf                = null     // output of -entry pairing

    // ------------------------------------------------------------- evidence
    proteins                    = 'auto'    // odb12:Fungi | swissprot | ncbi:GCA_x | path
    evidence_mode               = 'auto'    // auto|etp|et|ep|es|isoseq|dual

    // ------------------------------------------- functional annotation (-entry functional)
    proteome                    = null      // protein FASTA -- the only required input for this entry
    functional_modules          = 'swissprot,eggnog,dbcan'  // Phase A default; add interproscan,kofam,dbcan5 for Phase B
    max_hypothetical_frac       = 0.55      // QC guard: warn above this fraction with source=none
    swissprot_fasta              = '/data/genome/db/Swiss-prot/uniprot_sprot.fasta'
    swissprot_min_pident         = 30.0
    eggnog_db_dir                = '/data/genome/db/eggnog'
    eggnog_dmnd                  = '/data/genome/db/eggnog/eggnog_proteins.dmnd'
    cazy_db_dir                  = '/data/genome/db/CAZy'
    // Phase B (not yet wired -- see docs/functional_annotation.md)
    interproscan_datadir         = null
    kofam_profiles               = null
    funannotate2_db              = null

    // ------------------------------------------------------------------- QC
    run_multiqc                 = true

    // ------------------------------------------------------------------- misc
    offline                     = false
    on_missing_tool             = 'skip'    // skip|fail
    dry_run_strategy            = false
    priority                    = 'balanced'  // speed|balanced|quality
    time_budget                 = null        // e.g. '240.h' -- per heavy track
    db_dir                      = '/data/db/eukannot'
    validate_params             = true
    help                        = false
    version                     = false

    // --------------------------------------------------------------- resources
    max_cpus                    = 64
    max_memory                  = '480.GB'
    max_time                    = '720.h'
    gpu                         = 'auto'
    gpu_devices                 = '0'
}

// `fasta` is an alias for `genome`; resolved in main.nf, not here, because
// params are read-only once this block closes.
includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'
includeConfig 'conf/policy.config'

// Genome-size profile: only applied when the class is known up front.
// With genome_size_class = 'auto' the policy engine resolves it at runtime and
// the workflow honours strategy.yml instead. See docs/huge_genomes.md.
if( params.genome_size_class in ['tiny','small','medium','large','huge'] ) {
    includeConfig "conf/genome_size/${params.genome_size_class}.config"
}

profiles {
    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        singularity.cacheDir    = "${params.db_dir}/singularity"
        // autoMounts already binds the work dir; only add paths that live
        // outside it (databases, reference genomes on other filesystems).
        singularity.runOptions  = "--bind ${params.db_dir}"
        docker.enabled          = false
        conda.enabled           = false
        includeConfig 'conf/containers.config'
    }
    docker {
        docker.enabled          = true
        docker.userEmulation    = true
        singularity.enabled     = false
        conda.enabled           = false
        includeConfig 'conf/containers.config'
    }
    conda {
        conda.enabled           = true
        conda.channels          = ['conda-forge','bioconda']
        docker.enabled          = false
        singularity.enabled     = false
        includeConfig 'conf/conda.config'
    }
    gpu       { includeConfig 'conf/gpu.config'       }
    local64   { includeConfig 'conf/local64.config'   }
    test      { includeConfig 'conf/test.config'      }
    test_fungus { includeConfig 'conf/test_fungus.config' }
    test_mapping { includeConfig 'conf/test_mapping.config' }
    debug     { process.beforeScript = 'echo $HOSTNAME'; cleanup = false }
}

// Fall back to the bundled JDK-aware launcher's env if present.
env {
    PYTHONNOUSERSITE = 1
    LC_ALL           = 'C'
}

timeline { enabled = true; file = "${params.tracedir}/execution_timeline.html"; overwrite = true }
report   { enabled = true; file = "${params.tracedir}/execution_report.html";   overwrite = true }
trace    { enabled = true; file = "${params.tracedir}/execution_trace.txt";     overwrite = true }
dag      { enabled = true; file = "${params.tracedir}/pipeline_dag.html";       overwrite = true }

manifest {
    name            = 'Ufungi/symbiomics'
    author          = 'Ufungi'
    homePage        = 'https://github.com/Ufungi/symbiomics'
    description     = 'Decision-driven eukaryote genome annotation and mRNA-seq pipeline'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.10.0'
    version         = '0.1.0'
    license         = 'MIT'
}

// Resource clamping is done with process.resourceLimits in conf/base.config,
// which supersedes the old check_max() closure pattern.
