/*
 * huge: > 5 Gb.  Reference case: Pinus densiflora, 21.74 Gb, 2006 contigs,
 * largest contig 2.008 Gb, not softmasked.
 *
 * RESOURCES ONLY. Tool choices (masker, aligner, bam_index, which tracks run)
 * belong to the policy engine -- see subworkflows/local/decide_strategy and
 * conf/policy.config. Keeping them out of here avoids config-evaluation-order
 * bugs and keeps one source of truth for decisions.
 *
 * Every number below exists because of a measured constraint; read
 * docs/huge_genomes.md before changing any of it.
 */

process {
    // 38 GB HISAT2 index resident + sort buffers. Even with --mm (shared page
    // cache) 4 concurrent aligners is the ceiling on a 480 GB host.
    withName: 'HISAT2_ALIGN'  { maxForks = 4;  cpus = 12; memory = { 60.GB * task.attempt }; time = { 48.h  * task.attempt } }
    withName: 'HISAT2_BUILD'  { cpus = 32; memory = { 400.GB }; time = { 240.h } }
    withName: 'SAMTOOLS_SORT' { maxForks = 4;  cpus = 8;  memory = { 48.GB * task.attempt }; time = { 24.h * task.attempt } }
    withName: 'SAMTOOLS_INDEX'{ cpus = 4;  time = { 8.h * task.attempt } }
    withName: 'GENOME_STATS'  { cpus = 2;  time = { 8.h * task.attempt } }
    withName: 'STRINGTIE.*'   { maxForks = 4;  cpus = 8;  memory = { 48.GB * task.attempt }; time = { 24.h * task.attempt } }
    withName: 'FEATURECOUNTS|HTSEQ_COUNT' { cpus = 8; memory = { 64.GB * task.attempt }; time = { 24.h * task.attempt } }
    withName: 'INFER_STRANDEDNESS' { maxForks = 4; cpus = 8; memory = { 60.GB * task.attempt }; time = { 8.h * task.attempt } }

    withLabel: process_high        { cpus = 32; memory = { 400.GB * task.attempt }; time = { 240.h } }
    withLabel: process_high_memory { memory = { 450.GB }; time = { 240.h } }
    withLabel: process_long        { time = { 720.h } }
}
