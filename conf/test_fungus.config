/*
 * L2: Tricholoma matsutake, 160 Mb softmasked, public SE reads subsampled.
 * Exercises the full DAG on a real genome in a few hours.
 *   scripts/symbiomics run . -profile test_fungus,singularity,local64
 */

params {
    genome_size_class = 'small'
    genome            = null   // user must set: path to masked genome FASTA
    input             = "${projectDir}/tests/data/samplesheet_matsutake.csv"
    raw_dir           = null   // user must set: base directory for raw FASTQs
    outdir            = './results_test_fungus'
    genome_id         = 'Tmatsutake'
    species           = 'Tricholoma_matsutake'
    species_taxid     = 40145
    taxon             = 'fungi'
    premasked         = true
    masker            = 'none'
    test_mode         = true
    test_reads        = 200000
    counter           = 'both'
    reference_gff     = null   // user must set: path to gene annotation GFF
}
