/*
 * GPU passthrough. One 3090 on this host, so every GPU task is serialised by
 * the `gpu` label's maxForks = 1 in conf/base.config.
 */

process {
    withLabel: gpu {
        containerOptions = {
            workflow.containerEngine == 'singularity' ? '--nv' :
            workflow.containerEngine == 'docker'      ? '--gpus all' : ''
        }
    }
}

env {
    CUDA_VISIBLE_DEVICES = "${params.gpu_devices}"
}
