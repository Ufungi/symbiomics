/*
 * L1 smoke test: 75 kb organelle genome + tiny paired reads.
 * Runs the same code paths as a real run -- only the data volume differs.
 *   scripts/symbiomics run . -profile test,singularity
 */

params {
    genome_size_class = 'tiny'
    genome            = "${projectDir}/tests/data/mini.fasta"
    input             = "${projectDir}/tests/data/samplesheet_test.csv"
    outdir            = './results_test'
    test_mode         = true
    test_reads        = 20000
    strandedness_min_reads = 1000
    genome_id         = 'mini'
    species           = 'Test_organism'
    taxon             = 'fungi'
    masker            = 'none'
    strandedness      = 'auto'
    counter           = 'both'
    max_cpus          = 4
    max_memory        = '12.GB'
    max_time          = '2.h'
}

// The genome_size include in nextflow.config runs BEFORE profile params are
// applied, so -profile test alone never loads conf/genome_size/tiny.config
// and process_high keeps base's 72.GB request (fails on hosts with less RAM).
includeConfig 'genome_size/tiny.config'
