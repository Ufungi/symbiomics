/*
 * The lab box: 64 cores, ~503 GB RAM, 1x RTX 3090, NO scheduler.
 *
 * With a local executor Nextflow will happily launch as many tasks as the
 * declared cpus allow, which is how you accidentally hold N copies of a 38 GB
 * HISAT2 index in RAM. The executor caps below are the backstop.
 */

executor {
    name           = 'local'
    cpus           = 64
    memory         = '480.GB'
    queueSize      = 32
    pollInterval   = '3 sec'
}

params {
    max_cpus   = 64
    max_memory = '480.GB'
    max_time   = '720.h'
    db_dir     = '/data/db/eukannot'
}
