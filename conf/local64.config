/* Local executor profile for hosts without a scheduler. */

params {
    max_memory = '480.GB'
    max_time   = '720.h'
    db_dir     = null
}

executor {
    name           = 'local'
    cpus           = params.max_cpus as int
    memory         = '480.GB'
    queueSize      = 32
    pollInterval   = '3 sec'
}
