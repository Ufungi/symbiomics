/*
 * Decision thresholds for the policy engine (subworkflows/local/decide_strategy).
 * Everything here is data, not logic -- bin/decide_strategy.py reads these as
 * JSON and applies them. Override any of them on the command line.
 */

params {
    policy {
        // masker choice per (size_class, taxon); 'any' matches all taxa
        masker_by_class = [
            tiny  : [any: 'red'],
            small : [fungi: 'earlgrey', any: 'earlgrey'],
            medium: [plant: 'edta', fungi: 'earlgrey', any: 'earlgrey'],
            large : [any: 'repeatmodeler_subsample'],
            huge  : [any: 'red']
        ]
        // maskers that cannot finish at a given class -- requesting one errors
        masker_blocked = [
            large: ['earlgrey','edta'],
            huge : ['earlgrey','edta']
        ]

        // predictor tracks
        predictor_primary = [
            tiny: 'braker', small: 'braker', medium: 'braker',
            large: 'braker', huge: 'helixer'
        ]
        predictor_secondary = [
            huge: 'braker_sharded'
        ]
        predictor_blocked = [
            large: ['funannotate2'],
            huge : ['funannotate2','galba']
        ]
        // Tools with no model for the target clade. Recorded so nobody
        // re-proposes them; see docs/clade_notes.md.
        predictor_clade_unsupported = [
            tiberius: ['gymnosperm'],
            egapx   : ['fungi','gymnosperm']
        ]

        braker_shard_threshold   = 3000000000
        braker_shard_mb          = [large: 20, huge: 10]
        braker_shard_overlap_kb  = [large: 200, huge: 500]
        braker_train_subset_mb   = 300
        braker_max_bams          = 20

        // aligner
        star_blocked_above       = 2000000000
        hisat2_large_index_above = 4000000000
        hisat2_mm_index_above_gb = 8
        align_maxforks           = [tiny: 16, small: 8, medium: 6, large: 4, huge: 4]

        // BAI cannot address a contig longer than this
        bai_max_contig           = 536870912

        // heavy optional stages auto-disabled above a size
        disable_above = [
            infernal: 2000000000,
            qualimap: 2000000000,
            tesorter: 2000000000
        ]

        // default per-track wall-clock budgets; exceeded -> track dropped,
        // pipeline continues, omission recorded in strategy.yml and the report
        track_budget = [
            braker         : '240.h',
            braker_sharded : '240.h',
            helixer        : '96.h',
            galba          : '96.h',
            funannotate2   : '96.h',
            repeats        : '336.h'
        ]

        // BUSCO lineage suggestion by taxon (odb12)
        busco_lineage = [
            fungi : 'fungi_odb12',
            plant : 'embryophyta_odb12',
            animal: 'metazoa_odb12',
            other : 'eukaryota_odb12'
        ]
        // OrthoDB v12 clade partition by taxon
        odb_partition = [
            fungi : 'Fungi',
            plant : 'Viridiplantae',
            animal: 'Metazoa',
            other : 'Eukaryota'
        ]
    }
}
