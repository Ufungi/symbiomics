/*
 * L1 smoke test for -entry symbiont_mapping: same tiny organelle genome
 * offered twice under different ids, so the DAG (N samples x G genomes) is
 * exercised without needing a second real genome.
 *   scripts/symbiomics run . -entry symbiont_mapping -profile test_mapping,singularity
 */

params {
    input             = "${projectDir}/tests/data/samplesheet_test.tsv"
    mapping_genomes   = "${projectDir}/tests/data/mapping_genomes_test.tsv"
    outdir            = './results_test_mapping'
    strandedness      = 'unstranded'
    max_cpus          = 4
    max_memory        = '12.GB'
    max_time          = '2.h'
}
