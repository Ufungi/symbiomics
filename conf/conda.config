/*
 * -profile conda fallback.
 *
 * HONEST GAP LIST -- these tools have no usable conda recipe and are skipped
 * (or degraded) under this profile. The pipeline prints this at startup and
 * records SKIPPED(no conda recipe) in versions.yml so a Methods section cannot
 * silently overclaim:
 *
 *   Helixer 0.3.7      Docker only, not on bioconda  -> track unavailable
 *   InterProScan 6     tarball + --datadir           -> needs --ips_home
 *   AHRD 3.3.3         Java + ant build              -> scripts/build_ahrd.sh
 *   BRAKER 3/4         partial; AUGUSTUS config path -> container is supported path
 *   SignalP6/DeepLoc   license-gated                 -> DeepSig substitutes
 *
 * Governed by --on_missing_tool skip|fail. Explicitly requesting a skipped
 * tool is always a hard error regardless of that setting.
 */

process {
    withName: 'FASTQC'                       { conda = "${projectDir}/envs/fastqc.yml" }
    withName: 'FASTP'                        { conda = "${projectDir}/envs/fastp.yml" }
    withName: 'TRIMGALORE'                   { conda = "${projectDir}/envs/trim-galore.yml" }
    withName: 'SEQKIT.*'                     { conda = "${projectDir}/envs/seqkit.yml" }
    withName: 'HISAT2_BUILD'                 { conda = "${projectDir}/envs/hisat2.yml" }
    // hisat2 | samtools in one pipe, so one env must carry both.
    withName: 'HISAT2_ALIGN.*'               { conda = "${projectDir}/envs/hisat2-samtools.yml" }
    withName: 'SAMTOOLS_.*|BAM_STATS'        { conda = "${projectDir}/envs/samtools.yml" }
    withName: 'STRINGTIE.*'                  { conda = "${projectDir}/envs/stringtie.yml" }
    withName: 'GFFREAD'                      { conda = "${projectDir}/envs/gffread.yml" }
    withName: 'FEATURECOUNTS'                { conda = "${projectDir}/envs/subread.yml" }
    withName: 'HTSEQ_COUNT'                  { conda = "${projectDir}/envs/htseq.yml" }
    withName: 'AGAT_.*'                      { conda = "${projectDir}/envs/agat.yml" }
    withName: 'MULTIQC'                      { conda = "${projectDir}/envs/multiqc.yml" }
    withName: 'INFER_STRANDEDNESS|DECIDE_STRATEGY|GENOME_STATS|MERGE_COUNTS|INPUT_CHECK|INSPECT_ANNOTATION' {
        conda = "${projectDir}/envs/pyutils.yml"
    }
}
