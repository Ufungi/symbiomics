/*
 * Process resource labels. Every process carries exactly one process_* label.
 * resourceLimits clamps any request to what the host actually has, so a
 * genome_size profile can ask for 400.GB without breaking a small machine.
 */

process {
    resourceLimits = [
        cpus  : params.max_cpus as int,
        memory: params.max_memory as nextflow.util.MemoryUnit,
        time  : params.max_time as nextflow.util.Duration
    ]

    cpus   = 1
    memory = { 6.GB * task.attempt }
    time   = { 4.h  * task.attempt }

    errorStrategy = { task.exitStatus in [104,134,137,139,140,143,247] ? 'retry' : 'finish' }
    maxRetries    = 2
    maxErrors     = '-1'

    withLabel: process_single { cpus = 1;  memory = { 6.GB  * task.attempt }; time = { 4.h  * task.attempt } }
    withLabel: process_low    { cpus = 2;  memory = { 4.GB * task.attempt }; time = { 4.h  * task.attempt } }
    withLabel: process_medium { cpus = 8;  memory = { (params.process_medium_memory as nextflow.util.MemoryUnit) * task.attempt }; time = { 12.h * task.attempt } }
    withLabel: process_high   { cpus = 16; memory = { 72.GB * task.attempt }; time = { 24.h * task.attempt } }
    withLabel: process_long   { time = { 96.h * task.attempt } }
    withLabel: process_high_memory { memory = { 200.GB * task.attempt } }

    // Scheduling math: local executor admits tasks = min(budget/cpus, budget/memory).
    // process_high (16 cpu / 72 GB) exceeds a 60 GB budget -> only 1 HISAT2 task
    // runs at a time (16/32 cores). 12 cpu / 24 GB admits 2 -> 24/32 = 75%.
    // Large/huge genomes must set genome_size_class; those configs load AFTER
    // this file and override this selector with per-genome resources.
    withName: 'HISAT2_BUILD|HISAT2_ALIGN' { cpus = 12; memory = { 24.GB * task.attempt } }

    // One GPU on this class of host: never run two GPU tasks at once.
    withLabel: gpu { maxForks = 1 }

    // A track that blows its time budget must not kill the run -- the policy
    // engine records the omission and the pipeline finishes without it.
    withLabel: optional_track {
        errorStrategy = 'ignore'
        maxRetries    = 1
    }
}
