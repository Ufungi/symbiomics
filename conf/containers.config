/*
 * Single source of truth for container images.
 *
 * Pinning policy:
 *  - biocontainers (depot.galaxyproject.org / quay.io/biocontainers) tags are
 *    immutable by project policy, so a version--buildstring tag is enough.
 *  - Images whose tag provenance is NOT trustworthy are digest-pinned. That is
 *    currently: teambraker/braker3 (tag v3.1.1 was pushed 2026-06 while the
 *    GitHub releases stop at 3.0.8), helixer, interproscan, antismash,
 *    funannotate2. Digests are filled by scripts/check_digests.sh, which also
 *    runs weekly in CI and opens an issue if a pinned tag moves.
 *
 * Anything not listed here inherits process.container = null, i.e. it runs on
 * the host PATH. Nothing in the v0.1 DAG relies on that.
 */

process {
    withName: 'FASTQC' {
        container = 'https://depot.galaxyproject.org/singularity/fastqc:0.12.1--hdfd78af_0'
    }
    withName: 'FASTP' {
        container = 'https://depot.galaxyproject.org/singularity/fastp:0.23.4--h5f740d0_0'
    }
    withName: 'TRIMGALORE' {
        container = 'https://depot.galaxyproject.org/singularity/trim-galore:0.6.10--hdfd78af_0'
    }
    withName: 'SEQKIT.*' {
        container = 'https://depot.galaxyproject.org/singularity/seqkit:2.8.2--h9ee0642_0'
    }
    withName: 'HISAT2_BUILD' {
        container = 'https://depot.galaxyproject.org/singularity/hisat2:2.2.1--h503566f_8'
    }
    // HISAT2_ALIGN pipes straight into samtools so no SAM ever touches disk,
    // which means one image has to carry both. The plain hisat2 biocontainer
    // does not ship samtools; this mulled image is hisat2 2.2.1 + samtools.
    withName: 'HISAT2_ALIGN.*' {
        container = 'https://depot.galaxyproject.org/singularity/mulled-v2-a97e90b3b802d1da3d6958e0867610c718cb5eb1:2cdf6bf1e92acbeb9b2834b1c58754167173a410-0'
    }
    withName: 'SAMTOOLS_.*|BAM_STATS' {
        container = 'https://depot.galaxyproject.org/singularity/samtools:1.21--h50ea8bc_0'
    }
    withName: 'STRINGTIE.*' {
        container = 'https://depot.galaxyproject.org/singularity/stringtie:3.0.0--h29c0135_0'
    }
    withName: 'GFFREAD' {
        container = 'https://depot.galaxyproject.org/singularity/gffread:0.12.7--hdcf5f25_4'
    }
    withName: 'FEATURECOUNTS' {
        container = 'https://depot.galaxyproject.org/singularity/subread:2.0.6--he4a0461_2'
    }
    withName: 'HTSEQ_COUNT' {
        container = 'https://depot.galaxyproject.org/singularity/htseq:2.1.2--py310ha9eae8f_3'
    }
    withName: 'AGAT_.*' {
        container = 'https://depot.galaxyproject.org/singularity/agat:1.4.0--pl5321hdfd78af_0'
    }
    withName: 'MULTIQC' {
        container = 'https://depot.galaxyproject.org/singularity/multiqc:1.25.1--pyhdfd78af_0'
    }
    // Helpers in bin/. Only INFER_STRANDEDNESS genuinely needs pysam; the rest
    // are pure stdlib and just ride along in the same image.
    withName: 'INFER_STRANDEDNESS|DECIDE_STRATEGY|GENOME_STATS|MERGE_COUNTS|INPUT_CHECK|INSPECT_ANNOTATION' {
        container = 'https://depot.galaxyproject.org/singularity/pysam:0.24.0--py310h4a09ff2_1'
    }
}
