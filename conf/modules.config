/*
 * Per-process publishDir and ext.args. Stage directories are numbered so the
 * results tree reads in execution order (a convention carried over from the
 * lab's previous pipeline).
 */

process {
    // Safety net: no process may publish BAM/BAI/CSI into the results tree.
    // Alignments are CRAM+CRAI only; WASP/CRAM→BAM stay work-dir transient.
    publishDir = [
        path   : { "${params.outdir}/99_misc/${task.process.tokenize(':')[-1].toLowerCase()}" },
        mode   : params.publish_mode,
        saveAs : { fn ->
            if( fn.equals('versions.yml') ) return null
            if( fn.endsWith('.bam') || fn.endsWith('.bai') || fn.endsWith('.csi') ) return null
            return fn
        }
    ]

    withName: 'INPUT_CHECK|DECIDE_STRATEGY|GENOME_STATS' {
        publishDir = [ path: { "${params.outdir}/00_pipeline_info" }, mode: 'copy',
                       saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'SAMTOOLS_FAIDX|SEQKIT_SUBSET' {
        publishDir = [ path: { "${params.outdir}/10_genome" }, mode: params.publish_mode,
                       saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'FASTQC' {
        publishDir = [ path: { "${params.outdir}/30_reads/fastqc" }, mode: params.publish_mode,
                       saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'FASTP' {
        ext.args   = { "--length_required ${params.min_read_len}" }
    }
    withName: 'TRIMGALORE' {
        ext.args   = { "-length ${params.min_read_len}" }
    }
    withName: 'FASTP|TRIMGALORE' {
        publishDir = [
            [ path: { "${params.outdir}/30_reads/trim" }, mode: params.publish_mode,
              pattern: '*.{json,html,txt,log}' ],
            [ path: { "${params.outdir}/30_reads/trim" }, mode: params.publish_mode,
              pattern: '*.fastq.gz', enabled: params.test_mode ]
        ]
    }
    withName: 'INFER_STRANDEDNESS' {
        publishDir = [ path: { "${params.outdir}/35_strandedness" }, mode: 'copy',
                       saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'HISAT2_BUILD' {
        publishDir = [ path: { "${params.outdir}/40_align/index" }, mode: params.publish_mode,
                       enabled: false ]
    }
    withName: 'HISAT2_ALIGN' {
        publishDir = [ path: { "${params.outdir}/40_align/log" }, mode: 'copy',
                       pattern: '*.summary.txt' ]
    }
    withName: 'SAMTOOLS_SORT|SAMTOOLS_INDEX' {
        publishDir = [ path: { "${params.outdir}/40_align" }, mode: params.publish_mode,
                       pattern: '*.{cram,crai}', enabled: params.save_bam ]
    }
    withName: 'BAM_STATS' {
        publishDir = [ path: { "${params.outdir}/40_align/stats" }, mode: 'copy' ]
    }
    withName: 'STRINGTIE_ASSEMBLE|STRINGTIE_MERGE' {
        publishDir = [ path: { "${params.outdir}/45_assemble" }, mode: params.publish_mode,
                       saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'FEATURECOUNTS|HTSEQ_COUNT|MERGE_COUNTS|MERGE_COUNTS_HTSEQ|NORMALIZE_ANNOTATION|INSPECT_ANNOTATION|SALMON_TO_GENE_MATRIX' {
        publishDir = [ path: { "${params.outdir}/95_quantify" }, mode: 'copy',
                       saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'SALMON_QUANT' {
        // CLI params arrive as String ('30'); coerce before comparing to int.
        ext.args = { (params.salmon_bootstraps as int) > 0 ? "--numBootstraps ${params.salmon_bootstraps}" : '' }
        publishDir = [ path: { "${params.outdir}/95_quantify/salmon" }, mode: 'copy' ]
    }
    withName: 'SALMON_INDEX' {
        ext.args = { params.salmon_keep_duplicates.toString().toBoolean() ? '--keepDuplicates' : '' }
        publishDir = [ path: { "${params.outdir}/95_quantify/salmon" }, enabled: false ]
    }
    withName: 'SPLIT_HAPLOTYPE_COUNTS.*|SPLIT_COUNTS|SPLIT_TPM' {
        publishDir = [ path: { "${params.outdir}/95_quantify/haplotype_split" }, mode: 'copy',
                       saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'MULTIQC' {
        publishDir = [ path: { "${params.outdir}/99_report" }, mode: 'copy' ]
    }
    withName: 'DIAMOND_BLASTP_SWISSPROT|PARSE_SWISSPROT_HITS' {
        publishDir = [ path: { "${params.outdir}/80_functional/swissprot" }, mode: 'copy' ]
    }
    withName: 'EGGNOG_MAPPER' {
        publishDir = [ path: { "${params.outdir}/80_functional/eggnog" }, mode: 'copy' ]
    }
    withName: 'SIGNALP6|TARGETP2|DEEPLOC2|DEEPTMHMM|PHOBIUS|EFFECTORP|MEROPS_SCAN|CONSOLIDATE_PREDICTORS' {
        publishDir = [ path: { "${params.outdir}/80_functional/predictors" }, mode: 'copy',
                       saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'RUN_DBCAN' {
        publishDir = [ path: { "${params.outdir}/80_functional/dbcan" }, mode: 'copy' ]
    }
    withName: 'ASSIGN_PRODUCTS|QC_PRODUCTS|RENDER_ANNOTATION_REPORT' {
        publishDir = [ path: { "${params.outdir}/80_functional" }, mode: 'copy',
                       saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'DIAMOND_MAKEDB' {
        publishDir = [ path: { "${params.outdir}/80_functional/swissprot" }, enabled: false ]
    }
    withName: 'MINIMAP2_ASM|SYRI|SYRI_TO_PHASED_VCF|SYRI_TO_ALLELE_TABLE' {
        publishDir = [ path: { "${params.outdir}/70_haplotype_pairing" }, mode: 'copy',
                       saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]
    }
    withName: 'PHASER_GENE_AE' {
        publishDir = [ path: { "${params.outdir}/75_ase" }, mode: 'copy' ]
    }
    // ASE deferred: PHASER/WASP intermediates (incl. bias-corrected BAM) are
    // not published. Only gene_ae tables above ever leave the work dir.
    withName: 'PHASER|WASP_FIND_INTERSECTING_SNPS|WASP_FILTER_REMAPPED_READS|WASP_MERGE_KEEP' {
        publishDir = [ enabled: false ]
    }
    // Transient CRAM→BAM for WASP; regenerable from 40_align CRAM + reference.
    withName: 'SAMTOOLS_CRAM_TO_BAM|SAMTOOLS_CRAM_TO_BAM_REMAP' {
        publishDir = [ enabled: false ]
    }
}
