#!/usr/bin/env bash
# symbiomics launcher — pipeline-ordered subcommands, config-driven run.
#
# Nextflow >= 24 requires Java 17-21 (24.10.x tops out at 21). The system JVM
# on many hosts is Java 11, which makes the bare `nextflow` binary refuse to
# start. The conda env that ships Nextflow also ships its own JDK, so we point
# JAVA_CMD at it. This is the only supported entry point.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(dirname "$SCRIPT_DIR")"

# conda.sh location, in priority order:
#   1. SYMBIOMICS_CONDA_SH (explicit, from env or conf/host.sh)
#   2. a conda found on PATH (portable fallback)
#   3. the historical lab-box default (last resort)
HOST_CONF="$REPO_DIR/conf/host.sh"
if [[ -z "${SYMBIOMICS_CONDA_SH:-}" && -f "$HOST_CONF" ]]; then
    # shellcheck disable=SC1090
    source "$HOST_CONF"
fi
if [[ -z "${SYMBIOMICS_CONDA_SH:-}" ]]; then
    CONDA_BIN="$(command -v conda || true)"
    if [[ -n "$CONDA_BIN" ]]; then
        CONDA_BASE="$( "$CONDA_BIN" info --base 2>/dev/null || true )"
        if [[ -n "$CONDA_BASE" && -f "$CONDA_BASE/etc/profile.d/conda.sh" ]]; then
            SYMBIOMICS_CONDA_SH="$CONDA_BASE/etc/profile.d/conda.sh"
        fi
    fi
fi
: "${SYMBIOMICS_CONDA_SH:=/home/genome/anaconda3/etc/profile.d/conda.sh}"
: "${SYMBIOMICS_NF_ENV:=nextflow}"
: "${SYMBIOMICS_DB_DIR:=/data/db/eukannot}"

CMD="${1:-}"

# init / --help / bare symbiomics — no conda needed.
# `symbiomics init` copies config.example.yaml -> config.yaml (PlaceTax-style start);
# `symbiomics init -p <name>` scaffolds project/<name>/ with starter files.
if [[ "$CMD" == "init" ]]; then
    shift
    PROJ=""
    while (( $# > 0 )); do
        case "$1" in
            -p|--project)
                if [[ $# -lt 2 ]]; then
                    echo "ERROR: init -p/--project requires a project name" >&2
                    exit 1
                fi
                PROJ="$2"
                shift 2
                ;;
            --project=*)
                PROJ="${1#*=}"
                shift
                ;;
            -h|--help)
                echo "Usage: symbiomics init [-p <project-name>]" >&2
                echo "  (no args)  copy config.example.yaml -> config.yaml" >&2
                echo "  -p NAME    scaffold project/NAME/ (input/, output/, config.yaml)" >&2
                exit 0
                ;;
            *)
                echo "ERROR: unknown init option '$1'" >&2
                exit 1
                ;;
        esac
    done

    if [[ -n "$PROJ" ]]; then
        # Scaffold a new project: project/<name>/input (starter files) + output.
        if [[ ! "$PROJ" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
            echo "ERROR: invalid project name '$PROJ'" >&2
            echo "       use letters, digits, '.', '_', '-' (no slashes or spaces)" >&2
            exit 1
        fi
        PROJ_DIR="${REPO_DIR}/project/${PROJ}"
        if [[ -e "$PROJ_DIR" ]]; then
            echo "ERROR: project already exists: $PROJ_DIR" >&2
            echo "       pick a different name or remove it first" >&2
            exit 1
        fi
        mkdir -p "${PROJ_DIR}/input" "${PROJ_DIR}/output"
        for tpl in samplesheet.example.tsv genomes.example.tsv reference_proteomes.example.tsv; do
            src="${REPO_DIR}/assets/${tpl}"
            if [[ ! -f "$src" ]]; then
                echo "ERROR: template not found: $src" >&2
                exit 1
            fi
        done
        cp "$REPO_DIR/assets/samplesheet.example.tsv" "${PROJ_DIR}/input/samplesheet.tsv"
        cp "$REPO_DIR/assets/genomes.example.tsv" "${PROJ_DIR}/input/genomes.tsv"
        cp "$REPO_DIR/assets/reference_proteomes.example.tsv" "${PROJ_DIR}/input/reference_proteomes.tsv"
        cat > "${PROJ_DIR}/config.yaml" <<EOF
project: ${PROJ}
input: input/samplesheet.tsv
genome: input/genome.fasta
taxon: auto

# --- Runtime -----------------------------------------------------------------
profile: "singularity,local64"
EOF
        echo "[init] created project/${PROJ}/"
        echo "       input/samplesheet.tsv, input/genomes.tsv, input/reference_proteomes.tsv"
        echo "       input/genome.fasta   <- put your reference genome FASTA here"
        echo "       output/              <- all results land here"
        echo "       config.yaml (project: ${PROJ})"
        echo "       then run: symbiomics run --project ${PROJ}"
        exit 0
    fi

    CONFIG_EXAMPLE="${REPO_DIR}/config.example.yaml"
    CONFIG_TARGET="${REPO_DIR}/config.yaml"
    if [[ ! -f "$CONFIG_EXAMPLE" ]]; then
        echo "ERROR: config.example.yaml not found at $CONFIG_EXAMPLE" >&2
        exit 1
    fi
    cp "$CONFIG_EXAMPLE" "$CONFIG_TARGET"
    echo "[init] copied config.example.yaml -> config.yaml"
    echo "       open config.yaml and set at least: project, input, genome, taxon"
    echo "       then run: symbiomics run"
    exit 0
fi

if [[ "$CMD" == "--help" || $# -eq 0 ]]; then
    cat <<'HELP'
symbiomics — eukaryotic mRNA-seq & genome annotation Nextflow pipeline

Start a project (after ./setup.sh):
  symbiomics init -p <name>        # scaffold project/<name>/ (starter files + config)
  # edit project/<name>/input/samplesheet.tsv, put your genome.fasta in input/
  symbiomics run --project <name>  # run; results go to project/<name>/output/

Subcommands (pipeline order):
  init         scaffold a project: init -p <name> (or plain init -> config.yaml)
  preflight    check environment (java, nextflow, singularity, disk, db)
  download-db  provision functional-annotation databases (functional entry)
  strategy     show the full execution plan and stop (dry-run)
  run          run the whole mRNA-seq pipeline
  functional   functional annotation only (proteome input)

Starter files (init -p <name> copies these into project/<name>/input/):
  samplesheet.tsv           RNA-seq samplesheet (sample_id, fastq_1/2 or bam) [required]
  genomes.tsv               multi-genome batch table, one row per genome      [optional]
  reference_proteomes.tsv   weighted reference proteomes for product naming   [optional]
  config.yaml               run config: project/input/genome/taxon/profile

Output:
  project/<name>/output/     all results land here (structure: docs/usage.md)

Examples:
  symbiomics init -p matsutake
  symbiomics run --project matsutake
  symbiomics run -c config.yaml --genome other.fasta    # override one param

Full help: see docs/installation.md
HELP
    exit 0
fi

# Everything below needs the nextflow conda env.
if [[ ! -f "$SYMBIOMICS_CONDA_SH" ]]; then
    echo "ERROR: conda profile not found: $SYMBIOMICS_CONDA_SH" >&2
    echo "       Fix: run ./setup.sh (auto-detects conda and writes conf/host.sh)," >&2
    echo "       or set SYMBIOMICS_CONDA_SH to your conda.sh explicitly." >&2
    exit 1
fi
# shellcheck disable=SC1090
source "$SYMBIOMICS_CONDA_SH"

if ! conda activate "$SYMBIOMICS_NF_ENV" 2>/dev/null; then
    echo "ERROR: conda env '$SYMBIOMICS_NF_ENV' not found." >&2
    echo "       fix: run ./setup.sh (creates env '$SYMBIOMICS_NF_ENV' from envs/runner.yml)" >&2
    echo "       or:  conda create -n nextflow -c bioconda -c conda-forge nextflow openjdk=21" >&2
    exit 1
fi

# The env's bundled JDK. Nextflow honours JAVA_CMD above everything else.
if [[ -x "${CONDA_PREFIX}/lib/jvm/bin/java" ]]; then
    export JAVA_HOME="${CONDA_PREFIX}/lib/jvm"
    export JAVA_CMD="${JAVA_HOME}/bin/java"
elif [[ -x "${CONDA_PREFIX}/bin/java" ]]; then
    export JAVA_HOME="${CONDA_PREFIX}"
    export JAVA_CMD="${JAVA_HOME}/bin/java"
fi

# Work dir defaults to the big filesystem, never the smaller /data.
export NXF_WORK="${NXF_WORK:-${SYMBIOMICS_DB_DIR}/work}"
export NXF_SINGULARITY_CACHEDIR="${NXF_SINGULARITY_CACHEDIR:-${SYMBIOMICS_DB_DIR}/singularity}"
export NXF_OPTS="${NXF_OPTS:--Xms1g -Xmx8g}"
# RepeatMasker and other Perl tools emit locale warnings under ko_KR.UTF-8.
export LC_ALL="${LC_ALL:-C}"

mkdir -p "$NXF_WORK" "$NXF_SINGULARITY_CACHEDIR" 2>/dev/null || true

# Subcommand dispatch (pipeline order).
ENTRY=""
case "$CMD" in
    preflight)
        shift
        exec "${SCRIPT_DIR}/preflight.sh" "$@"
        ;;
    download-db)
        ENTRY="download_dbs"
        shift
        ;;
    strategy|functional)
        ENTRY="$CMD"
        shift
        ;;
    run)
        shift
        ;;
    *)
        echo "ERROR: unknown subcommand '$CMD'" >&2
        echo "       try: symbiomics --help" >&2
        exit 1
        ;;
esac

# ---------------------------------------------------------------------------
# Config file support: `symbiomics run -c config.yaml` (or --config).
# The config is parsed into Nextflow params (`--key value`); the CLI args
# that come after -c are appended last so they take precedence (last wins).
# ---------------------------------------------------------------------------
CONFIG_PATH=""
declare -a CLI_ARGS=()
while (( $# > 0 )); do
    case "$1" in
        -c|--config)
            if [[ $# -lt 2 ]]; then
                echo "ERROR: -c/--config requires a path argument" >&2
                exit 1
            fi
            CONFIG_PATH="$2"
            shift 2
            ;;
        --config=*)
            CONFIG_PATH="${1#*=}"
            shift
            ;;
        --project)
            if [[ $# -lt 2 ]]; then
                echo "ERROR: --project requires a name argument" >&2
                exit 1
            fi
            # PlaceTax-style: --project NAME == --outdir $REPO_DIR/project/NAME/output.
            # init -p scaffolds project/NAME/; its config.yaml is auto-loaded
            # here unless an explicit -c/--config was already given.
            if [[ -z "$CONFIG_PATH" && -f "$REPO_DIR/project/$2/config.yaml" ]]; then
                CONFIG_PATH="$REPO_DIR/project/$2/config.yaml"
            fi
            CLI_ARGS+=("--outdir" "$REPO_DIR/project/$2/output")
            shift 2
            ;;
        --project=*)
            _proj="${1#*=}"
            if [[ -z "$CONFIG_PATH" && -f "$REPO_DIR/project/$_proj/config.yaml" ]]; then
                CONFIG_PATH="$REPO_DIR/project/$_proj/config.yaml"
            fi
            CLI_ARGS+=("--outdir" "$REPO_DIR/project/$_proj/output")
            shift
            ;;
        *)
            CLI_ARGS+=("$1")
            shift
            ;;
    esac
done

# Default to the repo's config.yaml if one exists (created by `symbiomics init`).
if [[ -z "$CONFIG_PATH" && -f "$REPO_DIR/config.yaml" ]]; then
    CONFIG_PATH="$REPO_DIR/config.yaml"
fi

if [[ -n "$CONFIG_PATH" ]]; then
    if [[ ! -f "$CONFIG_PATH" ]]; then
        echo "ERROR: config file not found: $CONFIG_PATH" >&2
        exit 1
    fi
    # profile the CLI already sets wins over the config.
    has_cli_profile=0
    for a in "${CLI_ARGS[@]}"; do
        [[ "$a" == "-profile" || "$a" == "-profile="* ]] && has_cli_profile=1
    done

    # shellcheck disable=SC2207
    mapfile -t CFG_LINES < <("$SCRIPT_DIR/load_config.py" "$CONFIG_PATH" --keep-profile || exit 1)
    declare -a CFG_ARGS=()
    for kv in "${CFG_LINES[@]}"; do
        key="${kv%%=*}"
        val="${kv#*=}"
        if [[ "$key" == "profile" ]]; then
            [[ "$has_cli_profile" -eq 0 && -n "$val" ]] && CFG_ARGS+=("-profile" "$val")
        else
            CFG_ARGS+=("--$key" "$val")
        fi
    done

    # Config args first, CLI args last -> CLI wins (last arg wins in Nextflow).
    set -- "${CFG_ARGS[@]}" "${CLI_ARGS[@]}"
else
    set -- "${CLI_ARGS[@]}"
fi

# Pipeline path = first positional arg, default to this repo.
if (( $# == 0 )) || [[ "$1" == -* ]]; then
    set -- "$REPO_DIR" "$@"
fi

if [[ -n "$ENTRY" ]]; then
    exec nextflow run "$@" -entry "$ENTRY"
fi
exec nextflow run "$@"